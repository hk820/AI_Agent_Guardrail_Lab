# Student: leave blank for Offline demo; enter your own key for NexLLM mode.
NEXLLM_API_KEY=
NEXLLM_BASE_URL=https://www.nexllm.ai/v1
# Enter an exact model ID enabled in your NexLLM account. No model is assumed.
NEXLLM_MODEL=
# Some models require max_completion_tokens instead of max_tokens.
NEXLLM_TOKEN_PARAMETER=max_tokens

LAB_PORT=8765
# operator can propose simulated refunds; viewer cannot. Restart after editing.
LAB_ROLE=operator
LAB_MAX_LLM_CALLS=4
LAB_MAX_TOOL_CALLS=6
LAB_MAX_LIVE_CALLS=40
LAB_MAX_REQUEST_BYTES=48000
LAB_MAX_OUTPUT_TOKENS=700
LAB_REQUEST_TIMEOUT_SECONDS=25
LAB_TURN_TIMEOUT_SECONDS=75
LAB_APPROVAL_TTL_SECONDS=120
